# ---- Phase 1 ----
# Postgres (Neon/Supabase). Leave empty to use embedded PGlite in ./.data (dev/test only).
DATABASE_URL=
# Storage: STORAGE=gcs + GCS_BUCKET for Google Cloud Storage (private bucket); or Vercel Blob below; or local disk.
STORAGE=
GCS_BUCKET=
# Vercel Blob (private). Leave empty to store files on local disk in ./.data/blobs (dev only).
BLOB_READ_WRITE_TOKEN=
# AI provider: 'anthropic' (API key), 'vertex' (Claude on Vertex AI, needs per-model quota) or 'vertex-gemini' (Gemini on Vertex AI, immediate)
AI_PROVIDER=anthropic
AI_MODEL=                     # generic model id (fallback: ANTHROPIC_MODEL); e.g. gemini-2.5-pro for vertex-gemini
AI_MODEL_FAST=                # e.g. gemini-2.5-flash
AI_CLASSIFY_MODEL=            # model for HS classification (default: AI_MODEL); benchmark with /api/admin/ai-check
AI_CLASSIFY_THINKING_BUDGET=  # Gemini thinking budget for classification (tokens; 0 = off)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=europe-west1
# Anthropic (via Vercel AI SDK). Leave empty => AI_MOCK=true behaviour (fixture-based extraction/classification).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
AI_MOCK=
# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
APP_BASE_URL=http://localhost:3000
AUTH_DEV_LOGIN=true           # dev-only email login without magic link (never enable in production)
AUTH_RESEND_KEY=              # magic link via Resend (optional)
AUTH_EMAIL_FROM=noreply@example.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SUPERADMIN_EMAILS=            # comma-separated; access to /admin
# ---- Phase 2 ----
INBOUND_EMAIL_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VIBER_AUTH_TOKEN=             # [UNVERIFIED] Viber Bot API terms
FEATURE_VIBER=false
# ---- Phase 3 ----
# [UNVERIFIED endpoint] NBG official rates JSON. Rule is VERIFIED (Customs Code art.8: rate of registration day).
NBG_RATES_URL=https://nbg.gov.ge/gw/api/ct/monetarypolicy/currencies/ka/json
WORKING_HOURS_TZ=Asia/Tbilisi
CRON_SECRET=
PAYMENT_PROVIDER=mock         # [ASSUMPTION] Georgian provider via PaymentProvider interface
FEATURE_XML_EXPORT=true       # keep builder behind a flag (brief §7.5)
